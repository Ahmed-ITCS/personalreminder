# Copy to .env for local development. Never commit .env.
SECRET_KEY=replace-with-a-long-random-value
DATA_DIR=./data
DATABASE_PATH=reminders.sqlite3
APP_TIMEZONE=Asia/Karachi

# UltraMsg
ULTRAMSG_INSTANCE_ID=instance123456
ULTRAMSG_TOKEN=replace-with-your-ultramsg-token
ULTRAMSG_API_URL=https://api.ultramsg.com
ULTRAMSG_TIMEOUT=10
ULTRAMSG_WEBHOOK_TOKEN=replace-with-a-webhook-token
DEFAULT_COUNTRY_CODE=92

# Queue dispatcher
REMINDER_TASK_TOKEN=replace-with-a-task-token
REMINDER_POLL_LIMIT=10
REMINDER_MAX_ATTEMPTS=6
REMINDER_RETRY_BASE_SECONDS=300
REMINDER_STALE_SECONDS=900

# Dashboard (leave DASHBOARD_PASSWORD empty to disable HTTP Basic auth locally)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Local development only
FORCE_HTTPS=false
TRUST_PROXY=false
